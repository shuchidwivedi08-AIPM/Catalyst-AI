# Copy these values into Streamlit Community Cloud app secrets.
# Never commit real production credentials.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
SUPABASE_URL = "https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY = "sb_secret_YOUR_SERVER_SIDE_SECRET_KEY"

# Temporary migration fallback only. New deployments should use SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY = "YOUR_LEGACY_SERVICE_ROLE_JWT"